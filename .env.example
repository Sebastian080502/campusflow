# Plantilla de desarrollo. Cópiala como .env en la raíz del repositorio.
# No crees backend/.env. No subas .env. Los valores son placeholders.

APP_ENV=development
NODE_ENV=development
PORT=3000
APP_VERSION=dev
DATABASE_URL=postgresql://campusflow:change-me@localhost:5432/campusflow
POSTGRES_PASSWORD=change-me
JWT_SECRET=replace-with-a-secret-of-at-least-32-chars
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
SEED_ON_START=true
# Solo en local, sin servidor de correo. En producción debe quedar en false.
EXPOSE_RESET_TOKEN=false
SEED_ADMIN_EMAIL=admin@campusflow.local
SEED_ADMIN_NAME=Ana Administradora
SEED_ADMIN_PASSWORD=change-me-admin
SEED_STAFF_EMAIL=personal@campusflow.local
SEED_STAFF_NAME=Luis Encargado
SEED_STAFF_PASSWORD=change-me-staff
SEED_STUDENT_EMAIL=estudiante@campusflow.local
SEED_STUDENT_NAME=Maria Estudiante
SEED_STUDENT_PASSWORD=change-me-student
