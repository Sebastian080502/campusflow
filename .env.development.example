# Copia este archivo a .env y a backend/.env. Sustituye change-me.
# No subas esos archivos. SEED_ON_START solo en desarrollo local.

APP_ENV=development
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://campusflow:change-me@localhost:5432/campusflow
POSTGRES_PASSWORD=change-me
JWT_SECRET=replace-with-a-local-development-secret-32
CORS_ORIGIN=http://localhost:5173
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@campusflow.local
SEED_ADMIN_NAME=Ana Administradora
SEED_ADMIN_PASSWORD=change-me-admin
SEED_STAFF_EMAIL=personal@campusflow.local
SEED_STAFF_NAME=Luis Encargado
SEED_STAFF_PASSWORD=change-me-staff
SEED_STUDENT_EMAIL=estudiante@campusflow.local
SEED_STUDENT_NAME=Maria Estudiante
SEED_STUDENT_PASSWORD=change-me-student
