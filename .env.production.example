# Plantilla de producción. Vive solo en la EC2, junto a compose.prod.yml.
# No la subas. No definas APP_VERSION: la imagen ya trae el SHA corto del commit.
# No definas SEED_ON_START. La semilla no corre en producción.

APP_ENV=production
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://campusflow:change-me@db:5432/campusflow?schema=public
POSTGRES_PASSWORD=change-me
JWT_SECRET=replace-with-a-production-secret-at-least-32-chars
JWT_EXPIRES_IN=8h
CORS_ORIGIN=https://campusflow.example
EXPOSE_RESET_TOKEN=false
IMAGE=ghcr.io/example/campusflow
TAG=dev
