# Copia .env.development.example de la raiz, o este archivo, como backend/.env.
# JWT_SECRET debe tener al menos 32 caracteres. SEED_ON_START=true solo en local.

APP_ENV=development
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://campusflow:change-me@localhost:5432/campusflow
JWT_SECRET=replace-with-a-local-development-secret-32
CORS_ORIGIN=http://localhost:5173
SEED_ON_START=true
SEED_ADMIN_PASSWORD=change-me-admin
SEED_STAFF_PASSWORD=change-me-staff
SEED_STUDENT_PASSWORD=change-me-student
