# Placeholders del ambiente de QA. No contienen secretos reales.
# qa es la rama de promoción previa a producción. SEED_ON_START permanece apagado.

APP_ENV=qa
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://campusflow:change-me@postgres.qa.internal:5432/campusflow
POSTGRES_PASSWORD=change-me
JWT_SECRET=replace-with-a-qa-secret-at-least-32-chars
CORS_ORIGIN=https://qa.campusflow.example
SEED_ON_START=false
